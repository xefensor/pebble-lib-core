{
  "name": "pebble-watchface-core",
  "author": "Xef",
  "version": "0.5.2",
  "description": "Shared Pebble reading data, host transport and legacy context compatibility.",
  "main": "src/js/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/xefensor/pebble-lib-core.git"
  },
  "files": [
    "dist.zip",
    "readings.js",
    "src/js",
    "src/c",
    "include",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "pebble-package",
    "pebble",
    "watchface",
    "complications"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js && python3 scripts/test-native.py && npm run test:workflow && npm run check:docs && npm run test:release",
    "test:js": "node --test tests/*.test.js",
    "test:native": "python3 scripts/test-native.py",
    "test:source": "node --test tests/*.test.js && python3 scripts/test-native.py",
    "test:workflow": "python3 -m unittest discover -s tests -p test_development_workflow.py",
    "build": "python3 scripts/build.py",
    "pack:candidate": "python3 scripts/package-candidate.py",
    "release:package": "python3 scripts/package-release.py",
    "check:docs": "python3 scripts/check-docs.py",
    "release:prepare": "python3 scripts/github-release.py prepare",
    "release:publish": "python3 scripts/github-release.py publish",
    "test:release": "python3 -m unittest discover -s tests -p \"test_*release*.py\"",
    "check:setup": "python3 scripts/check-setup.py"
  },
  "dependencies": {},
  "pebble": {
    "projectType": "package",
    "sdkVersion": "3",
    "targetPlatforms": [
      "emery"
    ],
    "resources": {
      "media": []
    }
  }
}
